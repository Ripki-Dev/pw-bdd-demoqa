{
  "name": "playwright-bdd-allure-demo",
  "version": "0.1.0",
  "scripts": {
    "test": "npx bddgen && npx playwright test --project=$PROJECT",

    "watch:bdd": "nodemon -w ./features -e feature,js,ts --exec \"npx bddgen\"",
    "watch:pw": "npx bddgen && npx playwright test --ui",
    "watch": "run-p watch:*",

    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",

    "report": "npx http-server ./cucumber-report -c-1 -a localhost -o index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.9",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "dotenv": "^17.2.3",
    "http-server": "14.1.1",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "playwright-bdd": "^8.4.2",
    "prettier": "^3.8.0",
    "prettier-plugin-gherkin": "^3.1.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
